{
  "version": "1.7.1",
  "name": "leeson",
  "author": "SJ Lee",
  "description": "leeson total manage application",
  "private": true,
  "main": "main/index.js",
  "scripts": {
    "clean": "rimraf dist main renderer/out renderer/.next",
    "dev": "npm run build-renderer && npm run build-electron && electron .",
    "build-renderer": "next build renderer",
    "build-electron": "tsc -p electron-src",
    "build": "npm run build-renderer && npm run build-electron",
    "pack-app": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "type-check": "tsc -p ./renderer/tsconfig.json && tsc -p ./electron-src/tsconfig.json",
    "rebuild-native": "electron-rebuild",
    "postinstall": "npm run rebuild-native"
  },
  "dependencies": {
    "electron-is-dev": "^1.1.0",
    "electron-log": "^5.3.0",
    "electron-next": "^3.1.5",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.4.3",
    "keytar": "^7.9.0",
    "mariadb": "^3.4.0",
    "qs": "^6.13.0",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "^1.17.2",
    "@electron/rebuild": "^3.7.2",
    "@types/node": "^14.14.6",
    "@types/qs": "^6.9.15",
    "@types/react": "^16.9.9",
    "@types/react-dom": "^16.9.9",
    "@types/selenium-webdriver": "^4.1.19",
    "antd": "^5.23.1",
    "antd-style": "^3.7.1",
    "electron": "^27.0.2",
    "electron-builder": "^23.0.3",
    "next": "latest",
    "react": "^18.2.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.2.0",
    "rimraf": "^3.0.0",
    "typescript": "^4.0.5"
  },
  "build": {
    "appId": "com.leeson.app",
    "productName": "LeeSon",
    "publish": [
      {
        "provider": "github",
        "owner": "sjsylee",
        "repo": "leeson_desktop"
      }
    ],
    "asar": true,
    "mac": {
      "icon": "public/LeeSon.icns"
    },
    "files": [
      "main",
      "renderer",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
